# Aegis AI Liquid Vault Environment Configuration
# Copy this file to .env and fill in your actual values

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
NODE_ENV=development
PORT=3001
CORS_ORIGINS=http://localhost:3000,http://localhost:4173,http://localhost:5173

# =============================================================================
# GOOGLE GEMINI AI CONFIGURATION
# =============================================================================
# Required: Get your API key from https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-2.0-flash
GEMINI_MAX_TOKENS=8192
GEMINI_TEMPERATURE=0.1
GEMINI_TOP_P=0.8

# =============================================================================
# ZETACHAIN CONFIGURATION
# =============================================================================
ZETA_API_KEY=your_zetachain_api_key_here
ZETA_RPC_URL=https://zetachain-athens-evm.blockpi.network/v1/rpc/public
ZETA_CHAIN_ID=7000
ZETA_MAINNET_RPC_URL=https://zetachain-mainnet-evm.blockpi.network/v1/rpc/public
ZETA_MAINNET_CHAIN_ID=7001

# =============================================================================
# BLOCKCHAIN CONFIGURATION
# =============================================================================
PRIVATE_KEY=your_private_key_here
BACKEND_PRIVATE_KEY=your_backend_private_key_here

# Ethereum
ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/your_key
ETHEREUM_CHAIN_ID=1
ETHEREUM_VAULT_ADDRESS=0x...

# Base
BASE_RPC_URL=https://mainnet.base.org
BASE_CHAIN_ID=8453
BASE_VAULT_ADDRESS=0x...

# Avalanche
AVALANCHE_RPC_URL=https://api.avax.network/ext/bc/C/rpc
AVALANCHE_CHAIN_ID=43114
AVALANCHE_VAULT_ADDRESS=0x...

# Polygon
POLYGON_RPC_URL=https://polygon-rpc.com
POLYGON_CHAIN_ID=137
POLYGON_VAULT_ADDRESS=0x...

# Arbitrum
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
ARBITRUM_CHAIN_ID=42161
ARBITRUM_VAULT_ADDRESS=0x...

# Solana
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_CHAIN_ID=101
SOLANA_VAULT_ADDRESS=...

# Bitcoin
BTC_RPC_URL=http://localhost:8332
BTC_RPC_USER=your_btc_rpc_user
BTC_RPC_PASS=your_btc_rpc_password
BTC_VAULT_ADDRESS=bc1qxy2kgdygjrsqtzq2n0yrf2493p83kkfjhx0wlh

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
MONGODB_URI=mongodb://localhost:27017/aegis
REDIS_URL=redis://localhost:6379

# =============================================================================
# NOTIFICATION SERVICES
# =============================================================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
DISCORD_WEBHOOK_URL=your_discord_webhook_url

# =============================================================================
# AI SERVICE ENDPOINTS
# =============================================================================
AI_CREDIT_ENDPOINT=http://localhost:4006/api/gemini/credit-score
AI_RISK_ENDPOINT=http://localhost:4006/api/gemini/risk-assessment
AI_GENERATE_ENDPOINT=http://localhost:4006/api/gemini/generate

# =============================================================================
# ORACLE SERVICES
# =============================================================================
AEGIS_ORACLE_URL=https://oracle.aegis.ai/prices
CHAINLINK_ORACLE_URL=https://api.chain.link/v2

# =============================================================================
# SECURITY
# =============================================================================
JWT_SECRET=your_jwt_secret_here
AI_SERVICE_API_KEY=your_ai_service_api_key_here

# =============================================================================
# DEVELOPMENT
# =============================================================================
DEBUG=true
LOG_LEVEL=debug
